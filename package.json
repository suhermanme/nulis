{
  "name": "nulis",
  "version": "0.5.2",
  "private": true,
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @nulis/desktop",
    "dev": "npm run dev --workspace @nulis/desktop",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}

