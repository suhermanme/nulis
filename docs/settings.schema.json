{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/nulis/settings/v1.json",
  "title": "Nulis settings",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "values": {
      "type": "object",
      "properties": {
        "editor": {
          "type": "object",
          "properties": {
            "tabSize": { "type": "integer", "minimum": 1, "maximum": 32 },
            "wordWrap": { "type": "boolean" },
            "fontFamily": { "type": "string", "minLength": 1, "maxLength": 256 },
            "fontSize": { "type": "number", "minimum": 8, "maximum": 40 },
            "lineHeight": { "type": "number", "minimum": 1, "maximum": 2.5 },
            "fontLigatures": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "files": {
          "type": "object",
          "properties": {
            "associations": {
              "description": "File pattern (*.ext or an exact file name) to language ID.",
              "type": "object",
              "maxProperties": 256,
              "additionalProperties": { "type": "string", "maxLength": 255 }
            }
          },
          "additionalProperties": true
        },
        "lsp": {
          "type": "object",
          "properties": {
            "servers": {
              "description": "Language servers by ID. A server runs only after its exact command and language list are approved in Settings ▸ Languages ▸ Language servers.",
              "type": "object",
              "maxProperties": 32,
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "command": {
                    "description": "The program and its arguments; never a shell line.",
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
                  },
                  "languages": {
                    "description": "Language IDs the server is used for.",
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": { "type": "string" }
                  },
                  "initializationOptions": {
                    "description": "Passed as initializationOptions in the LSP initialize request."
                  }
                },
                "required": ["command", "languages"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        },
        "workbench": {
          "type": "object",
          "properties": {
            "colorTheme": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "patternProperties": {
        "^\\[[a-z0-9.-]+\\]$": {
          "description": "Settings that apply to one language, such as \"[python]\".",
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["schemaVersion", "values"],
  "additionalProperties": false
}
