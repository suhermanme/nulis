{
  "id": "nulis.tips",
  "name": "Nulis Tips",
  "version": "1.0.0",
  "engines": { "nulis": ">=0.1.0" },
  "permissions": ["showMessage"],
  "activationEvents": [
    "onStartup",
    "onCommand:nulis.tips.show",
    "onCommand:nulis.tips.count"
  ],
  "main": "index.js",
  "contributes": {
    "commands": [
      { "command": "nulis.tips.show", "title": "Show a Tip", "category": "Tips" },
      { "command": "nulis.tips.count", "title": "Count Tips", "category": "Tips" }
    ]
  }
}
