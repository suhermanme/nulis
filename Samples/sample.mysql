-- Nulis sample: MySQL / MariaDB
/* Schema and queries */
SET NAMES utf8mb4;
CREATE DATABASE IF NOT EXISTS nulis_sample;
USE nulis_sample;

-- Table 0: alpha
CREATE TABLE IF NOT EXISTS `alpha` (
  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  `name` VARCHAR(64) NOT NULL DEFAULT 'alpha',
  `score` DECIMAL(8,2) DEFAULT 0.50,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB;
SELECT `name`, AVG(`score`) AS avg_score FROM `alpha` WHERE `score` > 0 GROUP BY `name`;

-- Table 1: beta
CREATE TABLE IF NOT EXISTS `beta` (
  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
  `name` VARCHAR(64) NOT NULL DEFAULT 'beta',
  `score` DECIMAL(8,2) DEFAULT 1.50,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB;
SELECT `name`, AVG(`score`) AS avg_score FROM `beta` WHERE `score` > 1 GROUP BY `name`;

