<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- macOS 15 blocks connections to local network addresses (Remote over
       SFTP to a server at 192.168.x.x, for example) until the user allows
       them; without this text macOS refuses quietly instead of asking. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Nulis connects to SFTP servers on your local network when you open remote files.</string>
</dict>
</plist>
